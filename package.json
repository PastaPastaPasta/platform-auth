{
  "name": "@pastapastapasta/platform-auth",
  "version": "0.1.0",
  "description": "Reusable Dash Platform authentication orchestration for web apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PastaPastaPasta/platform-auth.git"
  },
  "bugs": {
    "url": "https://github.com/PastaPastaPasta/platform-auth/issues"
  },
  "homepage": "https://github.com/PastaPastaPasta/platform-auth#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./app-connect": {
      "import": {
        "types": "./dist/app-connect/index.d.ts",
        "default": "./dist/app-connect/index.js"
      },
      "require": {
        "types": "./dist/app-connect/index.d.cts",
        "default": "./dist/app-connect/index.cjs"
      }
    },
    "./passkey-vault": {
      "import": {
        "types": "./dist/passkey-vault/index.d.ts",
        "default": "./dist/passkey-vault/index.js"
      },
      "require": {
        "types": "./dist/passkey-vault/index.d.cts",
        "default": "./dist/passkey-vault/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.passkey-vault.json",
    "test": "vitest run && node --test tools/*.test.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "test:verbose": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:pack": "node tools/pack-smoke.mjs"
  },
  "keywords": [
    "dash",
    "platform",
    "auth",
    "react",
    "webauthn",
    "passkey"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
